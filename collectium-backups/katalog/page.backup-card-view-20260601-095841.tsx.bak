import Link from "next/link";
import type { CatalogObject } from "@/types/catalog";
import { searchCatalogObjects } from "@/db/queries/catalog";

export const dynamic = "force-dynamic";


type SearchParams = {
  q?: string;
  filter_field?: string;
  filter_value?: string;
};

type KatalogPageProps = {
  searchParams?: Promise<SearchParams>;
};

const filterFields: Array<{
  field: keyof CatalogObject & string;
  title: string;
}> = [
  { field: "country", title: "Land" },
  { field: "producer", title: "Produsent" },
  { field: "issuer", title: "Utsteder" },
  { field: "denomination", title: "Valør" },
  { field: "variant", title: "Variant" },
  { field: "litra", title: "Litra" },
  { field: "ruler", title: "Konge/regent" },
  { field: "historical_period", title: "Historisk periode" },
  { field: "material", title: "Materiale" },
  { field: "year_label", title: "År" },
  { field: "value_label", title: "Verdi" },
];

function buildFiltersFromObjects(objects: CatalogObject[]) {
  return filterFields
    .map((config) => {
      const counts = new Map<string, number>();

      for (const object of objects) {
        const rawValue = object[config.field];
        const value = typeof rawValue === "string" ? rawValue.trim() : "";

        if (value !== "") {
          counts.set(value, (counts.get(value) ?? 0) + 1);
        }
      }

      const values = Array.from(counts.entries())
        .map(([value, count]) => ({ value, count }))
        .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value))
        .slice(0, 10);

      return {
        ...config,
        values,
      };
    })
    .filter((group) => group.values.length > 0);
}

function makeFilterHref(field: string, value: string) {
  const params = new URLSearchParams();
  const dbField = field === "value_label" ? "value" : field;

  params.set("filter_field", dbField);
  params.set("filter_value", value);

  return `/katalog?${params.toString()}`;
}

function getSafeErrorMessage(error: unknown) {
  if (error instanceof Error) {
    return error.message;
  }

  return "Ukjent databasefeil.";
}

export default async function KatalogPage({ searchParams }: KatalogPageProps) {
  const params = (await searchParams) ?? {};

  const sourceKey = "norske_sedler";
  const objectGroup = "banknote";
  const q = params.q ?? "";
  const activeFilterField = params.filter_field ?? "";
  const activeFilterValue = params.filter_value ?? "";

  let objects: CatalogObject[] = [];
  let dbError: string | null = null;

  try {
    objects = await searchCatalogObjects(sourceKey, objectGroup, q, {
      filterField: activeFilterField,
      filterValue: activeFilterValue,
    });
  } catch (error) {
    dbError = getSafeErrorMessage(error);
    objects = [];
  }

  const filterGroups = buildFiltersFromObjects(objects);

  return (
    <div className="ct-grid">
      <section className="ct-panel">
        <h1 className="ct-title">Katalog</h1>

        <p className="ct-muted">
          source_key = {sourceKey} · object_group = {objectGroup}
        </p>

        <p className="ct-muted">
          Objekter: {objects.length} · Filtergrupper: {filterGroups.length}
        </p>

        {dbError && (
          <div
            style={{
              marginTop: 14,
              padding: 14,
              border: "1px solid #c94a4a",
              borderRadius: 10,
              background: "#fff5f5",
            }}
          >
            <strong>Database ikke tilgjengelig akkurat nå.</strong>
            <div className="ct-muted" style={{ marginTop: 6 }}>
              {dbError}
            </div>
            <div className="ct-muted" style={{ marginTop: 8 }}>
              Katalogen bruker nå Collectium API-bridge. Bridge svarer, men MariaDB avviser databasebrukeren eller host-tilgangen.
Data kan ikke vises før DB-bruker, passord eller tilgang er rettet i databasepanelet.
            </div>
          </div>
        )}

        {activeFilterField && activeFilterValue && (
          <p>
            Aktivt filter: <strong>{activeFilterField}</strong> ={" "}
            <strong>{activeFilterValue}</strong>{" "}
            <Link href="/katalog">Nullstill filter</Link>
          </p>
        )}
      </section>

      <section
        style={{
          display: "grid",
          gridTemplateColumns: "300px minmax(0, 1fr)",
          gap: 20,
          alignItems: "start",
        }}
      >
        <aside className="ct-panel">
          <h2>Filter</h2>
          <p className="ct-muted">Filter viser kun verdier fra aktiv treffliste.</p>

          {filterGroups.length === 0 && (
            <p className="ct-muted">Ingen filterverdier i trefflisten.</p>
          )}

          {filterGroups.map((group) => (
            <div key={group.field} style={{ marginBottom: 18 }}>
              <h3 style={{ fontSize: 14, marginBottom: 8 }}>{group.title}</h3>

              <div style={{ display: "grid", gap: 6 }}>
                {group.values.map((filter) => {
                  const dbField = group.field === "value_label" ? "value" : group.field;
                  const isActive =
                    activeFilterField === dbField &&
                    activeFilterValue === filter.value;

                  return (
                    <Link
                      key={`${group.field}-${filter.value}`}
                      href={makeFilterHref(group.field, filter.value)}
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        gap: 12,
                        padding: "7px 9px",
                        border: isActive ? "2px solid #1f5fbf" : "1px solid #d5dbe5",
                        borderRadius: 8,
                        background: isActive ? "#eef5ff" : "#fff",
                        textDecoration: "none",
                        color: "inherit",
                      }}
                    >
                      <span>{filter.value}</span>
                      <span className="ct-muted">{filter.count}</span>
                    </Link>
                  );
                })}
              </div>
            </div>
          ))}
        </aside>

        <section className="ct-card-list" data-view="list" data-segment="samler">
          {objects.length === 0 && (
            <article className="ct-object-row">
              <div>
                <strong>Ingen objekter funnet</strong>
                <div className="ct-muted">
                  {dbError
                    ? "Databasekoblingen må fungere før objekter kan vises."
                    : "Prøv å nullstille filteret."}
                </div>
              </div>
            </article>
          )}

          {objects.map((object) => (
            <article
              className="ct-object-row"
              key={`${object.source_key}-${object.object_group}-${object.object_id}`}
            >
              <div className="ct-thumb" />

              <div>
                <strong>
                  {object.collectium_title ?? object.frontend_title ?? "Uten tittel"}
                </strong>

                <div className="ct-muted">
                  {object.collectium_catalog_meta ?? object.source_catalog_number}
                </div>
              </div>

              <div>{object.value_label ?? "Ikke vurdert"}</div>
            </article>
          ))}
        </section>
      </section>
    </div>
  );
}
