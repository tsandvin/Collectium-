  "apis": [
    {
      "route": "/api/control/search",
      "method": "GET",
      "status": "dev",
      "purpose": "Search all pages/components/switches/apis for AI and developer panel.",
      "params": [
        "q"
      ],
      "returns": "manifest search results"
    },
    {
      "route": "/api/control/manifest",
      "method": "GET",
      "status": "dev",
      "purpose": "Return full developer manifest.",
      "params": [],
      "returns": "pages, components, switches, apis"
    },
    {
      "route": "/app/api/catalog/object.php",
      "method": "GET",
      "status": "planned",
      "purpose": "Resolved single object by source_key + object_group + object_id.",
      "params": [
        "source_key",
        "object_group",
        "object_id"
      ],
      "returns": "resolved catalog object"
    },
    {
      "route": "/app/api/catalog/filter.php",
      "method": "GET",
      "status": "planned",
      "purpose": "Source-scoped filter values in locked order.",
      "params": [
        "source_key",
        "object_group"
      ],
      "returns": "filter fields and values"
    },
    {
      "route": "/app/api/catalog/object-market.php",
      "method": "GET",
      "status": "planned",
      "purpose": "Market value/trend from price observations.",
      "params": [
        "source_key",
        "object_group",
        "object_id"
      ],
      "returns": "market fields"
    },
    {
      "route": "/app/api/admin/features.php",
      "method": "GET",
      "status": "locked",
      "purpose": "Feature/access matrix for admin.",
      "params": [
        "page_key"
      ],
      "returns": "page features and resolved access"
    },
    {
      "route": "/app/api/builder/component-data.php",
      "method": "GET",
      "status": "planned",
      "purpose": "Safe Builder component data endpoint.",
      "params": [
        "component",
        "page_key"
      ],
      "returns": "component-safe data"
    },
    {
      "route": "/api/deploy/preflight",
      "method": "POST",
      "status": "dev",
      "purpose": "AI/static preflight review before deploy confirmation.",
      "params": [
        "file",
        "content",
        "changes",
        "context"
      ],
      "returns": "preflight result with status, warnings and blockers"
    },
    {
      "route": "/api/deploy/mock",
      "method": "POST",
      "status": "dev",
      "purpose": "Mock/staging deploy record after second confirmation.",
      "params": [
        "preflightId",
        "file",
        "changes",
        "confirmed"
      ],
      "returns": "mock deploy receipt"
    }
  ],
  "figma_master_reference": {
    "name": "Figma / master brytere og felt",
    "status": "included_as_json_reference",
    "source_files_found": [
      "collectium-builder-control-global-v4.php",
      "collectium-builder-control-global-v18/v19.php",
      "collectium-builder-control-preview.php"
    ],
    "principles": [
      "Builder/AI can edit presentation, order, layout choices and safe fields for one page at a time.",
      "Collectium/MariaDB owns data, access, feature switches, routes, publish approval and live version.",
      "Each page needs page_key, components, switches, APIs, data sources and DB status.",
      "Switches can be boolean, text, select, number, JSON or safe_action."
    ]
  },
  "release_notes": [
    {
      "version": "1.4.0",
      "note": "Consistent package, folder, package.json, README and launcher naming."
    }
  ],
  "deploy_policy": {
    "mode": "mock_staging",
    "live_deploy_requires": [
      "approved_deploy_api_route",
      "server_side_git_or_sftp_connector",
      "role_based_access",
      "audit_log",
      "double_confirmation"
    ],
    "first_confirmation": "AI review / preflight",
    "second_confirmation": "Deploy confirmation",
    "blocking_rules": [
      "No direct MariaDB writes from frontend",
      "No overwriting core locked files without explicit approval",
      "No deploy if API/DB route status is missing or unsafe",
      "No deploy if file contains obvious syntax markers or unresolved conflicts"
    ]
  }
}